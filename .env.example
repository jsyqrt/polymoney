# Polymoney Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Polymarket CLOB (required for live trading)
# =============================================================================
POLYMARKET_PRIVATE_KEY=your_wallet_private_key_here
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137
# POLYMARKET_FUNDER=0x_your_funder_address  # Optional: proxy/funder address
# POLYMARKET_SIGNATURE_TYPE=0  # 0=EOA (default), 1=Magic, 2=Browser

# =============================================================================
# Risk Management
# =============================================================================
RISK_DAILY_LOSS_LIMIT=50.0
RISK_PER_MARKET_LOSS_LIMIT=10.0
RISK_CONSECUTIVE_LOSS_PAUSE=5
RISK_MAX_TOTAL_EXPOSURE=500.0
RISK_API_RATE_LIMIT=10

# =============================================================================
# Monitoring & Alerts
# =============================================================================
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# ALERT_ENABLE_ALERTS=true
# ALERT_ON_LOSS=0.8

# =============================================================================
# Trading
# =============================================================================
TRADING_MODE=paper
# TRADING_MAX_POSITION_SIZE=1000.0
# TRADING_ORDER_RATE_LIMIT=10

# =============================================================================
# Logging
# =============================================================================
# LOG_LEVEL=INFO
# LOG_FILE=polymoney.log
